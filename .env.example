# Nusxa oling: cp .env.example .env  va qiymatlarni EmailJS dashboard'dan to'ldiring.
# Bu kalitlar brauzerga yuboriladi (EmailJS public key shunday ishlaydi).
# Himoya uchun EmailJS dashboard'da: Account -> Security -> "Allowed origins" ga mehrzod.uz ni qo'shing.
PUBLIC_EMAILJS_SERVICE_ID=
PUBLIC_EMAILJS_TEMPLATE_ID=
PUBLIC_EMAILJS_PUBLIC_KEY=
