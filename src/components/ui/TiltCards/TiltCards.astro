---
// [data-tilt] kartalarga 3D egilish: sichqoncha ustida karta kursorga qarab egiladi (stillar komponentning CSS'ida).
// Skript faqat CSS o'zgaruvchilarini qo'yadi: --rx/--ry (burchak), --gx/--gy (nur markazi), --sx/--sy (soya siljishi)
// va egilish paytida data-tilting atributini. Faqat sichqonchali qurilmalarda va "harakatni kamaytirish" o'chiq bo'lsa.
---

<script>
  const MAX_DEG = 8;
  const SHADOW_PX = 24;

  const enabled =
    matchMedia('(hover: hover) and (pointer: fine)').matches &&
    !matchMedia('(prefers-reduced-motion: reduce)').matches;

  if (enabled) {
    document.querySelectorAll<HTMLElement>('[data-tilt]').forEach((card) => {
      let frame = 0;

      const reset = () => {
        cancelAnimationFrame(frame);
        card.removeAttribute('data-tilting');
        ['--rx', '--ry', '--gx', '--gy', '--sx', '--sy'].forEach((name) => card.style.removeProperty(name));
      };

      card.addEventListener('pointerenter', () => card.setAttribute('data-tilting', ''));
      card.addEventListener('pointerleave', reset);
      card.addEventListener('pointermove', (event) => {
        const rect = card.getBoundingClientRect();
        // Kursor o'rni karta ichida: 0..1
        const px = Math.min(1, Math.max(0, (event.clientX - rect.left) / rect.width));
        const py = Math.min(1, Math.max(0, (event.clientY - rect.top) / rect.height));
        cancelAnimationFrame(frame);
        frame = requestAnimationFrame(() => {
          // Kursor turgan tomon "bosiladi" (ichkariga), qarama-qarshi tomon ko'tariladi
          card.style.setProperty('--rx', `${((0.5 - py) * 2 * MAX_DEG).toFixed(2)}deg`);
          card.style.setProperty('--ry', `${((px - 0.5) * 2 * MAX_DEG).toFixed(2)}deg`);
          card.style.setProperty('--gx', `${(px * 100).toFixed(1)}%`);
          card.style.setProperty('--gy', `${(py * 100).toFixed(1)}%`);
          card.style.setProperty('--sx', ((0.5 - px) * SHADOW_PX).toFixed(1));
          card.style.setProperty('--sy', ((0.5 - py) * SHADOW_PX).toFixed(1));
        });
      });
    });
  }
</script>
