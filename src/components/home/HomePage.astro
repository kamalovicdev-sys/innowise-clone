---
import BaseLayout from '@layouts/BaseLayout.astro';
import Navbar from '@components/layout/Navbar/Navbar.jsx';
import Footer from '@components/layout/Footer/Footer.jsx';
import Hero from '@components/sections/Hero/Hero.jsx';
import Trust from '@components/sections/Trust/Trust.jsx';
import Problems from '@components/sections/Problems/Problems.jsx';
import Solutions from '@components/sections/Solutions/Solutions.jsx';
import Process from '@components/sections/Process/Process.jsx';
import Industries from '@components/sections/Industries/Industries.jsx';
import Integrations from '@components/sections/Integrations/Integrations.jsx';
import FAQ from '@components/sections/FAQ/FAQ.jsx';
import Contact from '@components/sections/Contact/Contact.jsx';
import ContactModal from '@components/ui/ContactModal/ContactModal.jsx';
import MobileCTA from '@components/ui/MobileCTA/MobileCTA.jsx';
import { getDictionary, getLanguageLinks, localizedPath } from '@i18n';
import { LEGAL_PAGES, CONTACT, SOCIAL_LINKS } from '@data/site';
import { INDUSTRIES } from '@data/sections';
import { getImage } from 'astro:assets';
import type { ImageMetadata } from 'astro';

const { lang } = Astro.props;
const dict = getDictionary(lang);
const languages = getLanguageLinks(lang);
const homeHref = localizedPath(lang);
// Maxfiylik siyosati e'lon qilinganda formalarda rozilik yozuvi va havola paydo bo'ladi
const privacyHref = LEGAL_PAGES.privacy ? localizedPath(lang, LEGAL_PAGES.privacy) : null;

// Tuzilgan ma'lumot (JSON-LD): Google'ga kompaniya, manzil va aloqa ma'lumotlarini aniq beradi
const site = Astro.site;
const orgId = new URL('/#organization', site).href;
const sameAs = [CONTACT.telegram, ...SOCIAL_LINKS.map((s) => s.href)].filter(Boolean);
const structuredData = [
  {
    '@context': 'https://schema.org',
    '@type': 'ProfessionalService',
    '@id': orgId,
    name: 'Mehrzod Business Group',
    url: new URL(homeHref, site).href,
    logo: new URL('/logo.png', site).href,
    image: new URL(`/og/og-${lang}.jpg`, site).href,
    description: dict.meta.description,
    telephone: CONTACT.phone,
    email: CONTACT.email,
    address: {
      '@type': 'PostalAddress',
      streetAddress: dict.footer.address.street,
      addressLocality: dict.footer.address.city,
      addressCountry: 'UZ',
    },
    geo: { '@type': 'GeoCoordinates', ...CONTACT.geo },
    areaServed: { '@type': 'Country', name: 'Uzbekistan' },
    knowsLanguage: ['uz', 'ru', 'en'],
    ...(sameAs.length > 0 ? { sameAs } : {}),
  },
  {
    '@context': 'https://schema.org',
    '@type': 'WebSite',
    '@id': new URL('/#website', site).href,
    url: new URL('/', site).href,
    name: 'Mehrzod Business Group',
    inLanguage: lang,
    publisher: { '@id': orgId },
  },
];

// Sohalar rasmlari: src/assets/industries/<id>.jpg. Bir xil ko'rinish uchun faqat HAMMA sohalar uchun fayl
// bo'lganda ishlatiladi (o'z serverimizdan, bir nechta o'lchamdagi WebP). Aks holda Industries ikonkali panel chizadi.
const INDUSTRY_IMAGE_SIZES = '(max-width: 992px) calc(100vw - 2.5rem), 560px';
// glob eager emas: rasmlar to'liq bo'lmasa fayllar import qilinmaydi va dist/ ga tushmaydi
const industrySources = import.meta.glob<ImageMetadata>('../../assets/industries/*.jpg', { import: 'default' });
const loaderFor = (id: string) => industrySources[`../../assets/industries/${id}.jpg`];
const hasAllImages = INDUSTRIES.every(({ id }) => loaderFor(id));
const industryImages = hasAllImages
  ? Object.fromEntries(
      await Promise.all(
        INDUSTRIES.map(async ({ id }) => {
          const src = await loaderFor(id)();
          const img = await getImage({ src, width: 1200, widths: [480, 800, 1200], format: 'webp', quality: 72 });
          return [
            id,
            { src: img.src, srcset: img.srcSet.attribute, sizes: INDUSTRY_IMAGE_SIZES, width: src.width, height: src.height },
          ];
        })
      )
    )
  : null;
---

<BaseLayout
  lang={lang}
  title={dict.meta.title}
  description={dict.meta.description}
  rememberLanguage={lang === 'uz'}
>
  <script is:inline slot="head" type="application/ld+json" set:html={JSON.stringify(structuredData)} />

  <a class="skip-link" href="#main">{dict.nav.skipToContent}</a>

  <!-- Interaktiv qismlar (client:*) brauzerda jonlanadi, qolganlari faqat tayyor HTML, JS'siz -->
  <Navbar client:load dict={dict.nav} languages={languages} homeHref={homeHref} />

  <main id="main" tabindex="-1">
    <Hero dict={dict.hero} />
    <!-- Haqiqiy raqam/logotip/fikr kiritilmaguncha (src/data/trust.js) bu blok chizilmaydi -->
    <Trust dict={dict.trust} lang={lang} />
    <!-- Asosiy format: Muammo → Oqibati → Yechimimiz -->
    <Problems dict={dict.problems} />
    <Solutions dict={dict.solutions} problems={dict.problems.items} />
    <Process dict={dict.process} />
    <Industries client:visible dict={dict.industries} labels={dict.problems.labels} images={industryImages} />
    <Integrations dict={dict.integrations} lang={lang} />
    <FAQ client:visible dict={dict.faq} />
    <Contact client:visible dict={dict.contact} formDict={dict.form} address={dict.footer.address} privacyHref={privacyHref} />
  </main>

  <Footer dict={dict.footer} homeHref={homeHref} lang={lang} />

  <MobileCTA dict={dict.quickContact} estimateLabel={dict.nav.contact} />

  <!-- Saytdagi yagona aloqa oynasi: [data-open-contact] tugmalarining barchasi shuni ochadi -->
  <ContactModal client:load dict={dict.contactModal} formDict={dict.form} privacyHref={privacyHref} />
</BaseLayout>

<script>
  // Mobil tezkor aloqa paneli: hero ekranda ko'rinib turganda yashirin, undan keyin paydo bo'ladi.
  // Yashirin paytda panel klaviatura va ekran o'quvchilar uchun ham yopiq (inert).
  const bar = document.querySelector<HTMLElement>('[data-mobile-cta]');
  const hero = document.getElementById('hero');

  const setVisible = (visible: boolean) => {
    if (!bar) return;
    bar.toggleAttribute('data-visible', visible);
    bar.inert = !visible;
  };

  if (bar && hero && 'IntersectionObserver' in window) {
    setVisible(false);
    new IntersectionObserver(([entry]) => setVisible(!entry.isIntersecting), { threshold: 0.15 }).observe(hero);
  } else {
    setVisible(true);
  }
</script>
