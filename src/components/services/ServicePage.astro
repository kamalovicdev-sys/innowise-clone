---
// Xizmat sahifasi (masalan /power-bi/, /ru/1c-analytics/): SEO va Google Ads uchun alohida landing.
// Ro'yxat: src/data/services.js, matnlar: src/locales/<til>/services.json.
// Umumiy bo'limlar (jarayon, integratsiyalar, aloqa) bosh sahifa bilan bir xil matndan olinadi.
import BaseLayout from '@layouts/BaseLayout.astro';
import Navbar from '@components/layout/Navbar/Navbar.jsx';
import Footer from '@components/layout/Footer/Footer.jsx';
import Hero from '@components/sections/Hero/Hero.jsx';
import Problems from '@components/sections/Problems/Problems.jsx';
import Deliverables from '@components/sections/Deliverables/Deliverables.jsx';
import Process from '@components/sections/Process/Process.jsx';
import Integrations from '@components/sections/Integrations/Integrations.jsx';
import RelatedServices from '@components/sections/RelatedServices/RelatedServices.jsx';
import FAQ from '@components/sections/FAQ/FAQ.jsx';
import Contact from '@components/sections/Contact/Contact.jsx';
import ContactModal from '@components/ui/ContactModal/ContactModal.jsx';
import MobileCTA from '@components/ui/MobileCTA/MobileCTA.jsx';
import MobileCTAToggle from '@components/ui/MobileCTA/MobileCTAToggle.astro';
import HeroDashboardLive from '@components/sections/Hero/HeroDashboardLive.astro';
import { getDictionary, getServiceDictionary, getLanguageLinks, localizedPath } from '@i18n';
import { LEGAL_PAGES } from '@data/site';
import { SERVICE_PAGES, getServicePage } from '@data/services';

const { lang, serviceKey } = Astro.props as { lang: 'uz' | 'ru' | 'en'; serviceKey: string };

const service = getServicePage(serviceKey);
if (!service) throw new Error(`Unknown service page: ${serviceKey}`);

const dict = getDictionary(lang);
const services = getServiceDictionary(lang);
const page = services.pages[serviceKey];
const path = `${service.slug}/`;
const homeHref = localizedPath(lang);
const privacyHref = LEGAL_PAGES.privacy ? localizedPath(lang, LEGAL_PAGES.privacy) : null;

// Hero: matn shu xizmatniki, demo dashbord bosh sahifadagi bilan bir xil (inglizcha)
const hero = page.hero;
const problems = { ...page.problems, labels: dict.problems.labels };
// FAQ: savollar shu xizmatniki, o'ng tomondagi chaqiriq kartasi umumiy
const faq = { ...dict.faq, title: page.faq.title, items: page.faq.items };

// Boshqa xizmatlar + bosh sahifadagi barcha yechimlar
const related = [
  ...SERVICE_PAGES.filter(({ key }) => key !== serviceKey).map(({ key, slug }) => ({
    key,
    href: localizedPath(lang, `${slug}/`),
    title: dict.servicePages[key],
    desc: services.pages[key].card,
  })),
  { key: 'solutions', href: `${homeHref}#solutions`, title: dict.solutions.title, desc: dict.solutions.subtitle },
];

// Tuzilgan ma'lumot: xizmat (kompaniyaga bog'langan) va "non" yo'li (bosh sahifa → xizmat)
const site = Astro.site;
const pageUrl = new URL(localizedPath(lang, path), site).href;
const structuredData = [
  {
    '@context': 'https://schema.org',
    '@type': 'Service',
    name: dict.servicePages[serviceKey],
    description: page.meta.description,
    url: pageUrl,
    provider: { '@type': 'ProfessionalService', '@id': new URL('/#organization', site).href, name: 'Mehrzod Business Group' },
    areaServed: { '@type': 'Country', name: 'Uzbekistan' },
    inLanguage: lang,
  },
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: services.common.home, item: new URL(homeHref, site).href },
      { '@type': 'ListItem', position: 2, name: dict.servicePages[serviceKey], item: pageUrl },
    ],
  },
];
---

<BaseLayout lang={lang} title={page.meta.title} description={page.meta.description} path={path}>
  <script is:inline slot="head" type="application/ld+json" set:html={JSON.stringify(structuredData)} />

  <a class="skip-link" href="#main">{dict.nav.skipToContent}</a>

  <Navbar
    client:load
    dict={dict.nav}
    languages={getLanguageLinks(lang, path)}
    homeHref={homeHref}
    anchorBase={homeHref}
  />

  <main id="main" tabindex="-1">
    <Hero dict={hero} exploreHref="#deliverables" />
    <Problems dict={problems} items={service.problems} />
    <Deliverables title={services.common.deliverablesTitle} dict={page.deliverables} items={service.deliverables} />
    <Process dict={dict.process} />
    <Integrations dict={dict.integrations} lang={lang} />
    <RelatedServices
      title={services.common.relatedTitle}
      subtitle={services.common.relatedSubtitle}
      moreLabel={services.common.more}
      items={related}
    />
    <FAQ client:visible dict={faq} items={Object.keys(page.faq.items)} />
    <Contact client:visible dict={dict.contact} formDict={dict.form} address={dict.footer.address} privacyHref={privacyHref} />
  </main>

  <Footer dict={dict.footer} homeHref={homeHref} lang={lang} pageLabels={dict.servicePages} anchorBase={homeHref} />

  <MobileCTA dict={dict.quickContact} estimateLabel={dict.nav.contact} />

  <ContactModal client:load dict={dict.contactModal} formDict={dict.form} privacyHref={privacyHref} />
  <MobileCTAToggle />
  <HeroDashboardLive />
</BaseLayout>
