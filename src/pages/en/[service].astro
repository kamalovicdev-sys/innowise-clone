---
// Xizmat sahifalari: /en/power-bi/, /en/1c-analytics/, /en/metabase/ (ro'yxat: src/data/services.js)
import ServicePage from '@components/services/ServicePage.astro';
import { SERVICE_PAGES } from '@data/services';

export function getStaticPaths() {
  return SERVICE_PAGES.map(({ key, slug }) => ({ params: { service: slug }, props: { serviceKey: key } }));
}

const { serviceKey } = Astro.props;
---

<ServicePage lang="en" serviceKey={serviceKey} />
